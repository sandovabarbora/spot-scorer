<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spot Scorer — Czech TV advertising fingerprint, on demand</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<style>{{ inline_css }}</style>
</head>
<body>
<main>

<header class="masthead">
    <p class="eyebrow">A tool, 2026 &mdash; companion to
        <a href="https://sandovabarbora.github.io/color-fingerprint-cz/" style="color:inherit;">Color fingerprint</a> +
        <a href="https://sandovabarbora.github.io/sound-fingerprint-cz/" style="color:inherit;">Sound fingerprint</a>
    </p>
    <h1>Spot Scorer.</h1>
    <p class="lede">Pick a spot. Get its color and audio metrics, the sector defaults it lives inside, and three to five numerical targets it would need to hit to read as distinctive. {{ n_spots }} spots, {{ n_brands }} brands.</p>
    <p class="byline">By Barbora Šandová. <a href="https://github.com/sandovabarbora/spot-scorer">Source on GitHub</a>.</p>
</header>

<section class="brief-block">
    <p class="brief-label">Generate a creative brief for a category</p>
    <p class="url-help">Pick a category. Get the numerical spec a distinctive new spot in that category would need to hit, derived from where the existing {{ n_brands }} brands actually live. Read this as a starter creative brief, not a verdict.</p>
    <div class="brief-form">
        <select id="brief-sector" class="url-sector">
{% for s in sectors %}
            <option value="{{ s }}"{% if loop.first %} selected{% endif %}>{{ s }}</option>
{% endfor %}
            <option value="All">All sectors</option>
        </select>
    </div>
    <div id="brief-result" class="brief-result"></div>
</section>

{% if modal_endpoint %}
<section class="url-block url-block-compare">
    <p class="url-label">Compare two spots</p>
    <p class="url-help">Score two videos side-by-side. Useful for "us vs them" pitches: paste a client's draft + a competitor's spot, get a paired scorecard showing where they differ on the same sector benchmark. Both spots scored at the same sector context.</p>
    <div class="cmp-form">
        <input id="cmp-url-a" type="url" class="url-input" placeholder="Spot A &mdash; https://www.youtube.com/watch?v=..." />
        <input id="cmp-url-b" type="url" class="url-input" placeholder="Spot B &mdash; https://www.youtube.com/watch?v=..." />
        <select id="cmp-sector" class="url-sector">
            <option value="All">All sectors</option>
{% for s in sectors %}
            <option value="{{ s }}">{{ s }}</option>
{% endfor %}
        </select>
        <button id="cmp-submit" class="url-submit" type="button">Compare</button>
    </div>
    <p class="url-example">
        Try it:
        <button type="button" id="cmp-example" class="url-example-btn">Pilsner Urquell &mdash; Alfons Mucha&nbsp;&nbsp;vs&nbsp;&nbsp;Lidl &mdash; Grilování</button>
    </p>
    <p id="cmp-status" class="url-status" hidden></p>
    <div id="cmp-results" class="cmp-results" hidden></div>
</section>

<section class="url-block">
    <p class="url-label">Score one video</p>
    <p class="url-help">Paste a YouTube link (most reliable), Facebook public post, or Instagram public post. Pick the brand's nearest sector for benchmark comparison. First call cold-starts the backend (~30s), subsequent calls take 10-25s.</p>
    <div class="url-form">
        <input id="url-input" type="url" class="url-input" placeholder="https://www.youtube.com/watch?v=..." />
        <select id="url-sector" class="url-sector">
            <option value="All">All sectors</option>
{% for s in sectors %}
            <option value="{{ s }}">{{ s }}</option>
{% endfor %}
        </select>
        <button id="url-submit" class="url-submit" type="button">Score</button>
    </div>
    <p id="url-status" class="url-status" hidden></p>
</section>
{% else %}
<section class="url-block url-block-disabled">
    <p class="url-label">Score any video</p>
    <p class="url-help">Backend not deployed in this build. To enable: deploy <code>backend/modal_app.py</code> to Modal and set <code>MODAL_ENDPOINT</code> before <code>make build</code>. See the README.</p>
</section>
{% endif %}

<section class="picker-block">
    <label for="spot-picker" class="picker-label">Or pick from the {{ n_spots }}-spot reference corpus</label>
    <select id="spot-picker" class="picker"></select>
    <div id="spot-header" class="spot-header"></div>
</section>

<section>
    <div class="section-label"><span class="num">01</span><h2>Color score</h2></div>
    <div id="color-panel" class="score-grid"></div>
</section>

<section>
    <div class="section-label"><span class="num">02</span><h2>Audio score</h2></div>
    <div id="audio-panel" class="score-grid"></div>
</section>

<section>
    <div class="section-label"><span class="num">03</span><h2>Sector context</h2></div>
    <p class="section-intro">Each gauge shows where this spot sits inside its sector's distribution. The shaded band is the inter-quartile range (p25 to p75); the dashed line is the median. A dot near the edge of the band means the spot is already pushing toward distinctive; a dot in the middle means it lives at the category default.</p>
    <div id="sector-panel"></div>
</section>

<section>
    <div class="section-label"><span class="num">04</span><h2>Brief targets</h2></div>
    <p class="section-intro">If the goal is a distinctive spot in this category, these are the numerical moves. Each target takes the spot OUT of the inter-quartile box on a single axis. Pick one or two; trying to move all of them at once defeats the focus.</p>
    <ol id="targets-panel" class="targets"></ol>
</section>

<footer>
    <div>
        <h4>How it works</h4>
        <p>Static page, vanilla JavaScript, no backend. Data inlined from the two sister studies.</p>
    </div>
    <div>
        <h4>Code</h4>
        <p><a href="https://github.com/sandovabarbora/spot-scorer">spot-scorer</a></p>
        <p><a href="https://github.com/sandovabarbora/color-fingerprint-cz">color-fingerprint-cz</a></p>
        <p><a href="https://github.com/sandovabarbora/sound-fingerprint-cz">sound-fingerprint-cz</a></p>
    </div>
    <div>
        <h4>Disclaimer</h4>
        <p>Analysis of publicly available video material. Brands and campaigns are referenced for analytical purposes only. No agency attribution is implied.</p>
    </div>
</footer>

</main>

<script>
window.SPOT_DATA = {{ inline_data | safe }};
window.MODAL_ENDPOINT = {{ modal_endpoint | tojson }};

(function () {
    const data = window.SPOT_DATA;
    const SVG_NS = "http://www.w3.org/2000/svg";

    const COLOR_METRICS = [
        { key: "color_gap_deg",   label: "Brand-color gap",       fmt: v => v.toFixed(0) + "°", range: [0, 180] },
        { key: "brand_anchor",    label: "Brand-color presence",  fmt: v => (v * 100).toFixed(0) + "%", range: [0, 1] },
        { key: "diversity",       label: "Palette diversity",     fmt: v => v.toFixed(1), range: [10, 35] },
        { key: "sat_std",         label: "Saturation tension",    fmt: v => v.toFixed(2), range: [0, 0.3] },
    ];
    const AUDIO_METRICS = [
        { key: "voice_fraction",  label: "Voice fraction",        fmt: v => (v * 100).toFixed(0) + "%", range: [0, 1] },
        { key: "music_fraction",  label: "Music fraction",        fmt: v => (v * 100).toFixed(0) + "%", range: [0, 1] },
        { key: "tempo_bpm",       label: "Tempo",                 fmt: v => v.toFixed(0) + " bpm", range: [60, 200] },
        { key: "rms_std",         label: "Dynamic range",         fmt: v => v.toFixed(2), range: [0, 0.2] },
    ];
    const SECTOR_METRICS = [...COLOR_METRICS, ...AUDIO_METRICS];

    // ---- DOM helpers (no innerHTML; safe by construction) ------------------
    function el(tag, opts) {
        const e = document.createElement(tag);
        if (opts) {
            if (opts.cls) e.className = opts.cls;
            if (opts.text !== undefined) e.textContent = opts.text;
            if (opts.style) Object.assign(e.style, opts.style);
            if (opts.attrs) for (const k in opts.attrs) e.setAttribute(k, opts.attrs[k]);
        }
        return e;
    }

    function svg(tag, attrs) {
        const e = document.createElementNS(SVG_NS, tag);
        if (attrs) for (const k in attrs) e.setAttribute(k, attrs[k]);
        return e;
    }

    function clear(node) {
        while (node.firstChild) node.removeChild(node.firstChild);
    }

    // ---- Build the spot picker grouped by brand ----------------------------
    const picker = document.getElementById("spot-picker");
    const byBrand = {};
    data.spots.forEach(s => {
        if (!byBrand[s.brand]) byBrand[s.brand] = [];
        byBrand[s.brand].push(s);
    });
    Object.keys(byBrand).sort().forEach(brand => {
        const group = document.createElement("optgroup");
        group.label = brand;
        byBrand[brand].forEach(s => {
            const opt = document.createElement("option");
            opt.value = s.spot_id;
            // Prefer the YouTube title (with diacritics); fall back to a
            // de-slugged spot_id if the enrichment hasn't run.
            const fallback = s.spot_id.replace(/^[a-z0-9_]+?_\d{2}_/, "").replace(/_/g, " ").trim();
            opt.textContent = s.title && s.title !== s.spot_id ? s.title : (fallback || s.spot_id);
            group.appendChild(opt);
        });
        picker.appendChild(group);
    });

    // ---- Build a gauge SVG via DOM ----------------------------------------
    function buildBriefGauge(lo_data, p25, median, p75, hi_data, target, pushLow) {
        // Position-arrow gauge for the Brief Generator. Shows the full
        // sector range, shades the IQR, ticks the median, and highlights
        // the target the brief is pointing toward.
        const W = 240, H = 30;
        const padL = 4, padR = 4;
        const usable = W - padL - padR;
        const span = Math.max(hi_data - lo_data, 1e-6);
        const x = v => padL + ((v - lo_data) / span) * usable;
        const root = svg("svg", { class: "brief-gauge", viewBox: `0 0 ${W} ${H}` });
        // Base line
        root.appendChild(svg("line", {
            x1: padL, y1: H / 2, x2: W - padR, y2: H / 2,
            stroke: "#E2DDD0", "stroke-width": "1.5",
        }));
        // IQR band
        root.appendChild(svg("rect", {
            x: x(p25), y: H / 2 - 4, width: Math.max(x(p75) - x(p25), 1), height: 8,
            fill: "#E2DDD0",
        }));
        // Median tick
        root.appendChild(svg("line", {
            x1: x(median), y1: H / 2 - 6, x2: x(median), y2: H / 2 + 6,
            stroke: "#888", "stroke-width": "1", "stroke-dasharray": "2 2",
        }));
        // Target highlight (editorial-red wedge pointing in the push direction)
        const tx = x(target);
        // Draw a triangle pointing left (push lower) or right (push higher)
        const triPath = pushLow
            ? `M${tx - 6},${H / 2} L${tx},${H / 2 - 6} L${tx},${H / 2 + 6} Z`
            : `M${tx + 6},${H / 2} L${tx},${H / 2 - 6} L${tx},${H / 2 + 6} Z`;
        root.appendChild(svg("path", { d: triPath, fill: "oklch(0.46 0.16 25)" }));
        // Vertical marker line at target
        root.appendChild(svg("line", {
            x1: tx, y1: H / 2 - 9, x2: tx, y2: H / 2 + 9,
            stroke: "oklch(0.46 0.16 25)", "stroke-width": "2",
        }));
        return root;
    }

    function buildGauge(value, p25, p75, median, lo, hi, anchor) {
        const W = 280, H = 28;
        const padL = 6, padR = 6;
        const usable = W - padL - padR;
        const x = v => padL + ((v - lo) / (hi - lo)) * usable;

        const root = svg("svg", {
            class: "gauge",
            viewBox: `0 0 ${W} ${H}`,
        });
        root.appendChild(svg("line", {
            x1: padL, y1: H / 2, x2: W - padR, y2: H / 2,
            stroke: "#E2DDD0", "stroke-width": "2",
        }));
        const bandW = Math.max(x(p75) - x(p25), 1);
        root.appendChild(svg("rect", {
            x: x(p25), y: H / 2 - 4, width: bandW, height: 8,
            fill: "#E2DDD0",
        }));
        root.appendChild(svg("line", {
            x1: x(median), y1: H / 2 - 6, x2: x(median), y2: H / 2 + 6,
            stroke: "#888", "stroke-width": "1", "stroke-dasharray": "2 2",
        }));
        root.appendChild(svg("circle", {
            cx: x(value), cy: H / 2, r: "5",
            fill: anchor || "#181818", stroke: "#181818", "stroke-width": "1",
        }));
        return root;
    }

    function metricCard(spot, metric, bench, anchor) {
        const value = spot[metric.key];
        const card = el("div", { cls: "metric-card" });
        card.appendChild(el("p", { cls: "metric-label", text: metric.label }));
        card.appendChild(el("p", { cls: "metric-value", text: metric.fmt(value) }));
        if (bench) {
            const lo = Math.min(bench.min, metric.range[0]);
            const hi = Math.max(bench.max, metric.range[1]);
            card.appendChild(buildGauge(value, bench.p25, bench.p75, bench.median, lo, hi, anchor));
            let pos;
            if (value < bench.p25) pos = "below sector p25";
            else if (value > bench.p75) pos = "above sector p75";
            else pos = "inside sector inter-quartile range";
            card.appendChild(el("p", { cls: "metric-note", text: pos }));
        }
        return card;
    }

    function sectorRow(spot, metric, bench, anchor) {
        const wrap = el("div", { cls: "sector-row" });
        wrap.appendChild(el("p", { cls: "sector-row-label", text: metric.label }));
        wrap.appendChild(el("p", { cls: "sector-row-value", text: metric.fmt(spot[metric.key]) }));
        const lo = Math.min(bench.min, metric.range[0]);
        const hi = Math.max(bench.max, metric.range[1]);
        wrap.appendChild(buildGauge(spot[metric.key], bench.p25, bench.p75, bench.median, lo, hi, anchor));
        wrap.appendChild(el("p", {
            cls: "sector-row-context",
            text: `sector median ${metric.fmt(bench.median)}, IQR ${metric.fmt(bench.p25)} to ${metric.fmt(bench.p75)}`,
        }));
        return wrap;
    }

    // ---- Render -----------------------------------------------------------
    function render(spot) {
        if (!spot) return;
        const bench = data.sector_benchmarks[spot.sector] || data.sector_benchmarks["All"] || {};

        // Header
        const header = document.getElementById("spot-header");
        clear(header);
        if (spot.anchor_hex) {
            header.appendChild(el("span", { cls: "spot-dot", style: { background: spot.anchor_hex }}));
        }
        const brandLabel = spot.brand || spot.title || "Submitted URL";
        header.appendChild(el("span", { cls: "spot-brand", text: brandLabel }));
        header.appendChild(el("span", { cls: "spot-sep", text: " · " }));
        header.appendChild(el("span", { cls: "spot-sector", text: spot.sector || "All" }));
        if (spot.key && spot.mode) {
            header.appendChild(el("span", { cls: "spot-sep", text: " · " }));
            header.appendChild(el("span", { cls: "spot-key", text: `${spot.key} ${spot.mode}` }));
        }
        if (spot.arc_shape) {
            header.appendChild(el("span", { cls: "spot-sep", text: " · " }));
            header.appendChild(el("span", { cls: "spot-arc", text: `arc ${spot.arc_shape}` }));
        }

        // Color + audio panels
        const colorPanel = document.getElementById("color-panel");
        clear(colorPanel);
        COLOR_METRICS.forEach(m => colorPanel.appendChild(metricCard(spot, m, bench[m.key], spot.anchor_hex)));

        const audioPanel = document.getElementById("audio-panel");
        clear(audioPanel);
        AUDIO_METRICS.forEach(m => audioPanel.appendChild(metricCard(spot, m, bench[m.key], spot.anchor_hex)));

        // Sector panel
        const sectorPanel = document.getElementById("sector-panel");
        clear(sectorPanel);
        const grid = el("div", { cls: "sector-row-grid" });
        SECTOR_METRICS.forEach(m => {
            const b = bench[m.key];
            if (b) grid.appendChild(sectorRow(spot, m, b, spot.anchor_hex));
        });
        sectorPanel.appendChild(grid);

        // Brief targets
        const targets = document.getElementById("targets-panel");
        clear(targets);
        if (!spot.brief_targets || spot.brief_targets.length === 0) {
            targets.appendChild(el("li", {
                cls: "target-empty",
                text: "This spot already sits outside the sector inter-quartile range on every measured axis.",
            }));
            return;
        }
        spot.brief_targets.forEach(t => {
            const li = el("li", { cls: "target-item" });
            const meta = SECTOR_METRICS.find(m => m.key === t.metric);
            const label = meta ? meta.label : t.metric;
            const fmt = meta ? meta.fmt : (v => v.toFixed(2));
            li.appendChild(el("p", { cls: "target-metric", text: label }));
            const move = el("p", { cls: "target-move" });
            move.appendChild(document.createTextNode(`Move ${t.direction}: from `));
            move.appendChild(el("span", { cls: "cur", text: fmt(t.current) }));
            move.appendChild(document.createTextNode(" to "));
            move.appendChild(el("span", { cls: "tgt", text: fmt(t.target) }));
            li.appendChild(move);
            li.appendChild(el("p", { cls: "target-rationale", text: t.rationale }));
            targets.appendChild(li);
        });
    }

    function renderById(id) {
        const spot = data.spots.find(s => s.spot_id === id);
        if (spot) render(spot);
    }

    // ---- Brief Generator (no backend — uses inline benchmarks) -----------
    const briefSector = document.getElementById("brief-sector");
    const briefResult = document.getElementById("brief-result");

    // Per metric: direction the brief should push and human-readable phrasing
    // 'extreme' direction is split into "low" or "high" by the spot's typical
    // distinctive position; for new briefs we recommend the more open
    // direction (further from sector median).
    const BRIEF_METRICS = [
        { key: "color_gap_deg",   label: "Brand-color gap",       fmt: v => v.toFixed(0) + "°",
          low_phrase: "commit to brand color", high_phrase: "commit to a world" },
        { key: "brand_anchor",    label: "Brand-color presence",  fmt: v => (v * 100).toFixed(0) + "%",
          low_phrase: "let the picture be a world", high_phrase: "flood with brand color" },
        { key: "diversity",       label: "Palette diversity",     fmt: v => v.toFixed(1),
          low_phrase: "monothematic palette", high_phrase: "wide palette" },
        { key: "sat_std",         label: "Saturation tension",    fmt: v => v.toFixed(2),
          low_phrase: "steady saturation", high_phrase: "swinging saturation" },
        { key: "voice_fraction",  label: "Voice fraction",        fmt: v => (v * 100).toFixed(0) + "%",
          low_phrase: "let music carry", high_phrase: "voice-led narration" },
        { key: "music_fraction",  label: "Music fraction",        fmt: v => (v * 100).toFixed(0) + "%",
          low_phrase: "voice-led narration", high_phrase: "let music carry" },
        { key: "tempo_bpm",       label: "Tempo",                 fmt: v => v.toFixed(0) + " bpm",
          low_phrase: "slow / cinematic pacing", high_phrase: "uptempo / energetic pacing" },
        { key: "rms_std",         label: "Dynamic range",         fmt: v => v.toFixed(2),
          low_phrase: "flat loudness", high_phrase: "build-and-payoff dynamics" },
    ];

    function renderBrief(sector) {
        clear(briefResult);
        const bench = data.sector_benchmarks[sector];
        if (!bench) {
            briefResult.appendChild(el("p", { cls: "brief-note", text: "No benchmark for that sector." }));
            return;
        }

        // Top three spots already in this sector (for "what's already here")
        const sectorSpots = data.spots
            .filter(s => s.sector === sector)
            .map(s => ({ brand: s.brand, color_gap_deg: s.color_gap_deg,
                         voice_fraction: s.voice_fraction, music_fraction: s.music_fraction,
                         brand_anchor: s.brand_anchor }))
            .slice(0, 3);

        // Header
        briefResult.appendChild(el("p", { cls: "brief-header",
            text: `Brief — to read as distinctive in ${sector}` }));

        // Table of metric targets
        const grid = el("div", { cls: "brief-grid" });
        BRIEF_METRICS.forEach(m => {
            const b = bench[m.key];
            if (!b) return;
            const card = el("div", { cls: "brief-card" });
            card.appendChild(el("p", { cls: "brief-card-label", text: m.label }));

            // Recommend the more-open direction (whichever is further from median).
            const distLow = b.median - b.p25;
            const distHigh = b.p75 - b.median;
            const pushLow = distLow >= distHigh;
            const target = pushLow ? b.p25 : b.p75;
            const phrase = pushLow ? m.low_phrase : m.high_phrase;
            const dirArrow = pushLow ? "↓" : "↑";

            const targetP = el("p", { cls: "brief-card-target" });
            targetP.appendChild(el("span", { cls: "brief-arrow", text: dirArrow }));
            targetP.appendChild(document.createTextNode(" " + (pushLow ? "≤ " : "≥ ") + m.fmt(target)));
            card.appendChild(targetP);

            card.appendChild(el("p", { cls: "brief-card-phrase", text: phrase }));

            // Position arrow gauge: ─ p25 ── median ── p75 ─ with target highlight
            card.appendChild(buildBriefGauge(b.min, b.p25, b.median, b.p75, b.max, target, pushLow));

            card.appendChild(el("p", { cls: "brief-card-context",
                text: `sector median ${m.fmt(b.median)}, IQR ${m.fmt(b.p25)}–${m.fmt(b.p75)}` }));
            grid.appendChild(card);
        });
        briefResult.appendChild(grid);

        // Already-occupied positions
        if (sectorSpots.length > 0) {
            briefResult.appendChild(el("p", { cls: "brief-section-label",
                text: "Already in this sector" }));
            const list = el("ul", { cls: "brief-occupants" });
            sectorSpots.forEach(s => {
                const li = el("li");
                const summary = `${s.brand}: gap ${s.color_gap_deg.toFixed(0)}°, ` +
                                `anchor ${(s.brand_anchor * 100).toFixed(0)}%, ` +
                                `voice ${(s.voice_fraction * 100).toFixed(0)}%`;
                li.textContent = summary;
                list.appendChild(li);
            });
            briefResult.appendChild(list);
        }

        // Draft brief card — copy-paste ready
        const draft = el("div", { cls: "brief-draft" });
        draft.appendChild(el("p", { cls: "brief-draft-label", text: "Draft brief copy" }));
        const text = buildDraftCopy(sector, bench);
        draft.appendChild(el("pre", { cls: "brief-draft-text", text: text }));
        briefResult.appendChild(draft);
    }

    function buildDraftCopy(sector, bench) {
        function fmtGap(v) { return v.toFixed(0) + "°"; }
        function fmtPct(v) { return (v * 100).toFixed(0) + "%"; }
        const gap = bench["color_gap_deg"];
        const anchor = bench["brand_anchor"];
        const voice = bench["voice_fraction"];
        const tempo = bench["tempo_bpm"];
        const dyn = bench["rms_std"];
        // Decide direction per metric
        const gapDir = (gap.median - gap.p25) >= (gap.p75 - gap.median) ? "low" : "high";
        const anchorDir = (anchor.median - anchor.p25) >= (anchor.p75 - anchor.median) ? "low" : "high";
        const voiceDir = (voice.median - voice.p25) >= (voice.p75 - voice.median) ? "low" : "high";

        const lines = [
            `CREATIVE BRIEF — distinctive ${sector} spot`,
            ``,
            `Color:`,
            `  · brand-color gap   ${gapDir === "low" ? "≤ " + fmtGap(gap.p25) : "≥ " + fmtGap(gap.p75)}` +
                `  (sector median ${fmtGap(gap.median)})`,
            `  · brand presence    ${anchorDir === "low" ? "≤ " + fmtPct(anchor.p25) : "≥ " + fmtPct(anchor.p75)}` +
                `  (sector median ${fmtPct(anchor.median)})`,
            ``,
            `Audio:`,
            `  · voice fraction    ${voiceDir === "low" ? "≤ " + fmtPct(voice.p25) : "≥ " + fmtPct(voice.p75)}` +
                `  (sector median ${fmtPct(voice.median)})`,
            `  · tempo              ${tempo.p25.toFixed(0)}–${tempo.p75.toFixed(0)} bpm  (target away from sector default)`,
            `  · dynamic range      ${dyn.p25.toFixed(2)}–${dyn.p75.toFixed(2)}`,
            ``,
            `Position: push out of the sector IQR on at least two metrics.`,
            `Decide brand-color vs world-color in the brief, not the cut.`,
            `Run draft through Spot Scorer on dailies, before picture lock.`,
        ];
        return lines.join("\n");
    }

    briefSector.addEventListener("change", e => renderBrief(e.target.value));
    renderBrief(briefSector.value);

    // ---- URL submission (Modal endpoint) ----------------------------------
    const endpoint = window.MODAL_ENDPOINT;
    if (endpoint) {
        const urlInput = document.getElementById("url-input");
        const urlSector = document.getElementById("url-sector");
        const urlBtn = document.getElementById("url-submit");
        const status = document.getElementById("url-status");

        function setStatus(text, kind) {
            status.textContent = text;
            status.hidden = !text;
            status.className = "url-status" + (kind ? " url-status-" + kind : "");
        }

        async function submitUrl() {
            const url = (urlInput.value || "").trim();
            if (!/^https?:\/\//.test(url)) {
                setStatus("Paste a URL starting with http:// or https://", "error");
                return;
            }
            urlBtn.disabled = true;
            setStatus("Downloading and analysing… first call cold-starts the backend (~30s).", "loading");
            try {
                const resp = await fetch(endpoint, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ url, sector: urlSector.value }),
                });
                const result = await resp.json();
                if (!resp.ok || result.error) {
                    setStatus("Backend error: " + (result.error || resp.statusText), "error");
                    return;
                }
                setStatus("Scored. Result rendered below.", "ok");
                // Build a spot-like object for render()
                result.brand = result.brand || "Submitted URL";
                result.anchor_hex = result.anchor_hex || "#181818";
                render(result);
            } catch (err) {
                setStatus("Network error: " + err.message, "error");
            } finally {
                urlBtn.disabled = false;
            }
        }
        urlBtn.addEventListener("click", submitUrl);
        urlInput.addEventListener("keypress", e => { if (e.key === "Enter") submitUrl(); });
    }

    // ---- Compare two spots ------------------------------------------------
    if (endpoint) {
        const cmpA = document.getElementById("cmp-url-a");
        const cmpB = document.getElementById("cmp-url-b");
        const cmpSector = document.getElementById("cmp-sector");
        const cmpBtn = document.getElementById("cmp-submit");
        const cmpStatus = document.getElementById("cmp-status");
        const cmpResults = document.getElementById("cmp-results");

        function setCmpStatus(text, kind) {
            cmpStatus.textContent = text;
            cmpStatus.hidden = !text;
            cmpStatus.className = "url-status" + (kind ? " url-status-" + kind : "");
        }

        async function scoreOne(url, sector) {
            const resp = await fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ url, sector }),
            });
            const j = await resp.json();
            if (!resp.ok || j.error) throw new Error(j.error || resp.statusText);
            return j;
        }

        function shortLabel(url) {
            try {
                const u = new URL(url);
                return u.hostname.replace(/^www\./, "") + u.pathname.slice(0, 18);
            } catch { return url.slice(0, 40); }
        }

        function diffArrow(a, b, higherIsBetter) {
            if (a == null || b == null) return "";
            const d = a - b;
            if (Math.abs(d) < 1e-6) return "=";
            const aHigher = d > 0;
            const cls = (aHigher === higherIsBetter) ? "diff-pos" : "diff-neg";
            return `<span class="diff ${cls}">${aHigher ? "↑" : "↓"}</span>`;
        }

        function comparisonRow(metric, spotA, spotB, bench) {
            const wrap = el("div", { cls: "cmp-row" });
            wrap.appendChild(el("p", { cls: "cmp-row-label", text: metric.label }));

            const aVal = spotA[metric.key];
            const bVal = spotB[metric.key];

            const aCell = el("div", { cls: "cmp-cell cmp-a" });
            aCell.appendChild(el("p", { cls: "cmp-val", text: aVal != null ? metric.fmt(aVal) : "—" }));
            if (bench && aVal != null) {
                const lo = Math.min(bench.min, metric.range[0]);
                const hi = Math.max(bench.max, metric.range[1]);
                aCell.appendChild(buildGauge(aVal, bench.p25, bench.p75, bench.median, lo, hi, "#181818"));
            }
            wrap.appendChild(aCell);

            const bCell = el("div", { cls: "cmp-cell cmp-b" });
            bCell.appendChild(el("p", { cls: "cmp-val", text: bVal != null ? metric.fmt(bVal) : "—" }));
            if (bench && bVal != null) {
                const lo = Math.min(bench.min, metric.range[0]);
                const hi = Math.max(bench.max, metric.range[1]);
                bCell.appendChild(buildGauge(bVal, bench.p25, bench.p75, bench.median, lo, hi, "oklch(0.46 0.16 25)"));
            }
            wrap.appendChild(bCell);

            return wrap;
        }

        function renderComparison(spotA, spotB) {
            clear(cmpResults);
            const sector = spotA.sector || spotB.sector || "All";
            const bench = data.sector_benchmarks[sector] || data.sector_benchmarks["All"] || {};

            // Header row
            const headers = el("div", { cls: "cmp-row cmp-row-headers" });
            headers.appendChild(el("p", { cls: "cmp-row-label", text: "" }));
            headers.appendChild(el("div", { cls: "cmp-cell cmp-a" })).appendChild(
                el("p", { cls: "cmp-hdr", text: shortLabel(spotA.url || "Spot A") })
            );
            headers.appendChild(el("div", { cls: "cmp-cell cmp-b" })).appendChild(
                el("p", { cls: "cmp-hdr", text: shortLabel(spotB.url || "Spot B") })
            );
            cmpResults.appendChild(headers);

            // Section: color
            cmpResults.appendChild(el("p", { cls: "cmp-section", text: "Color" }));
            COLOR_METRICS.forEach(m => cmpResults.appendChild(comparisonRow(m, spotA, spotB, bench[m.key])));

            // Section: audio
            cmpResults.appendChild(el("p", { cls: "cmp-section", text: "Audio" }));
            AUDIO_METRICS.forEach(m => cmpResults.appendChild(comparisonRow(m, spotA, spotB, bench[m.key])));

            cmpResults.hidden = false;
        }

        async function submitCompare() {
            const a = (cmpA.value || "").trim();
            const b = (cmpB.value || "").trim();
            if (!/^https?:\/\//.test(a) || !/^https?:\/\//.test(b)) {
                setCmpStatus("Both URLs must start with http:// or https://", "error");
                return;
            }
            cmpBtn.disabled = true;
            setCmpStatus("Scoring two spots in parallel… (~25-50s)", "loading");
            try {
                const [spotA, spotB] = await Promise.all([
                    scoreOne(a, cmpSector.value),
                    scoreOne(b, cmpSector.value),
                ]);
                setCmpStatus("Done. Side-by-side rendered below.", "ok");
                renderComparison(spotA, spotB);
            } catch (err) {
                setCmpStatus("Backend error: " + err.message, "error");
            } finally {
                cmpBtn.disabled = false;
            }
        }
        cmpBtn.addEventListener("click", submitCompare);
        [cmpA, cmpB].forEach(input => {
            input.addEventListener("keypress", e => { if (e.key === "Enter") submitCompare(); });
        });

        const cmpExample = document.getElementById("cmp-example");
        if (cmpExample) {
            cmpExample.addEventListener("click", () => {
                cmpA.value = "https://www.youtube.com/watch?v=dLDHfeOEp38";
                cmpB.value = "https://www.youtube.com/watch?v=Oz047619h6U";
                const sectorSel = document.getElementById("cmp-sector");
                if (sectorSel) {
                    const beverageOpt = Array.from(sectorSel.options).find(o => o.value === "Beverage");
                    sectorSel.value = beverageOpt ? "Beverage" : "All";
                }
                submitCompare();
            });
        }
    }

    // Initial render from picker
    const first = data.spots[0]?.spot_id;
    if (first) {
        picker.value = first;
        renderById(first);
    }
    picker.addEventListener("change", e => renderById(e.target.value));
})();
</script>
</body>
</html>
