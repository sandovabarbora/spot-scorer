/*
 * Editorial film-still register. Bodoni Moda for display + numerals,
 * Manrope for body. OKLCH neutrals with a single saturated accent.
 * Asymmetric grid; varied rhythm; numbered sections as the visual motif.
 */

@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,11..96,400..900;1,11..96,400..900&family=Manrope:wght@400;500;600;700&display=swap');

:root {
    --paper:     oklch(0.985 0.005 80);
    --ink:       oklch(0.18  0.01  80);
    --ink-soft:  oklch(0.36  0.01  80);
    --ink-faint: oklch(0.55  0.008 80);
    --rule:      oklch(0.85  0.008 80);
    --rule-soft: oklch(0.92  0.005 80);
    --accent:    oklch(0.46  0.16  25);
    --serif: "Bodoni Moda", "Times New Roman", serif;
    --sans:  "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }

html, body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

main {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 88px) clamp(20px, 4vw, 56px) 96px;
}

/* ============ Header ============ */

.masthead {
    border-bottom: 1px solid var(--rule);
    padding-bottom: clamp(32px, 4vw, 48px);
    margin-bottom: clamp(56px, 6vw, 88px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
}

.eyebrow {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 4px;
}

.masthead h1 {
    font-family: var(--serif);
    font-weight: 700;
    font-optical-sizing: auto;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--ink);
}

.masthead .lede {
    font-family: var(--sans);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.5;
    color: var(--ink);
    max-width: 56ch;
    margin: 0;
}

.masthead .byline {
    font-size: 13px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    margin: 0;
}

.masthead .byline a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
}

.masthead .byline a:hover {
    border-bottom-color: var(--accent);
    color: var(--accent);
}

/* ============ Section labels ============ */

.section-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: clamp(64px, 7vw, 96px) 0 clamp(28px, 3vw, 40px);
}

.section-label .num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 24px);
    color: var(--accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
}

.section-label h2 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
}

.section-intro {
    color: var(--ink-soft);
    font-size: 15px;
    max-width: 62ch;
    margin: -4px 0 36px;
    line-height: 1.65;
}

/* ============ Method block ============ */

.method {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    margin-bottom: clamp(56px, 7vw, 88px);
}

.method-label {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 6px;
}

.method-body {
    font-family: var(--sans);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
    max-width: 62ch;
}

/* ============ Per-brand strips ============ */

.strips-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-bottom: clamp(48px, 6vw, 80px);
}

.brand-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
}

.brand-meta .name {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(16px, 1.4vw, 19px);
    margin: 0 0 4px;
    line-height: 1.2;
    letter-spacing: -0.01em;
}

.brand-meta .sector {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
}

.brand-meta .swatch {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    vertical-align: middle;
    margin-right: 8px;
    transform: translateY(-1px);
}

.strip {
    display: block;
    width: 100%;
    height: 68px;
}

.brand-spark {
    margin-top: 10px;
    max-width: 160px;
}

.brand-spark .spark {
    width: 100%;
    height: 28px;
    display: block;
}

/* ============ Sector CI block under scatter ============ */

.sector-ci-block {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--rule-soft);
}

.ci-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 12px;
}

.ci-note {
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 10px 0 0;
    max-width: 60ch;
}

.sector-ci {
    display: block;
    width: 100%;
    max-width: 760px;
}

/* ============ Polar radial grid ============ */

.radial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(20px, 2vw, 28px) clamp(16px, 2vw, 24px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.radial-cell {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
}

.radial-cell .radial {
    width: 100%;
    max-width: 140px;
    height: auto;
    display: block;
}

.radial-cell figcaption {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.radial-cell .rc-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.2;
}

.radial-cell .rc-sector {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

/* ============ Dendrogram ============ */

.dendrogram-frame {
    margin: 0;
}

.dendrogram {
    display: block;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
}

/* ============ Pull-quote ============ */

.pull {
    margin: clamp(40px, 5vw, 64px) 0;
    padding: clamp(28px, 4vw, 48px) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
}

.pull-q {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
}

.pull-q .num {
    color: var(--accent);
    font-weight: 700;
}

.pull-cap {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin: 0;
    max-width: 48ch;
}

/* ============ Scatter ============ */

.scatter-frame {
    margin: 0 auto clamp(8px, 1vw, 12px);
    max-width: 620px;
}

.scatter {
    display: block;
    width: 100%;
}

.scatter-cap {
    text-align: center;
    color: var(--ink-soft);
    font-size: 12px;
    letter-spacing: 0.04em;
    margin: 8px 0 0;
    font-family: var(--sans);
}

/* ============ Gap chart ============ */

.gap-frame {
    margin: 0 0 clamp(40px, 5vw, 64px);
}

.gap-chart {
    display: block;
    width: 100%;
    max-width: 760px;
}

/* ============ Patterns ============ */

.patterns {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 72px);
    margin-bottom: clamp(48px, 6vw, 80px);
}

.pattern {
    display: grid;
    grid-template-columns: clamp(72px, 8vw, 108px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
}

.pattern .num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(52px, 6vw, 80px);
    line-height: 0.85;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    margin: 0;
}

.pattern h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 23px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 14px;
    color: var(--ink);
    max-width: 32ch;
}

.pattern .evidence {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    max-width: 62ch;
}

.pattern .takeaway {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 62ch;
}

.pattern .takeaway strong {
    color: var(--ink);
    font-weight: 600;
    letter-spacing: 0.02em;
    font-size: 11px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
}

/* ============ Playbook ============ */

.playbook {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 3vw, 40px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.play {
    display: grid;
    grid-template-columns: clamp(64px, 7vw, 88px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: baseline;
    padding-bottom: clamp(24px, 3vw, 32px);
    border-bottom: 1px solid var(--rule-soft);
}

.play:last-child {
    border-bottom: none;
}

.play .play-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(36px, 4.5vw, 56px);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0;
}

.play h3 {
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 0 12px;
    color: var(--ink);
    max-width: 36ch;
}

.play .play-body {
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.65;
    max-width: 62ch;
}

/* ============ Colophon ============ */

footer {
    margin-top: clamp(64px, 8vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.55;
}

footer h4 {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 8px;
    color: var(--ink);
}

footer p { margin: 0 0 6px; }
footer a { color: var(--ink-soft); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 2px; }
footer a:hover { color: var(--accent); }

/* ============ Responsive ============ */

@media (max-width: 640px) {
    .method,
    .brand-row,
    .pattern,
    .play {
        grid-template-columns: 1fr;
    }
    .method-label {
        padding-top: 0;
    }
    .pattern .num,
    .play .play-num {
        font-size: 40px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}

/* ============ Audio-specific charts ============ */

.split-frame {
    margin: 0 0 8px;
}

.split-chart {
    display: block;
    width: 100%;
    max-width: 800px;
}

.brand-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2vw, 28px);
    margin-bottom: clamp(48px, 6vw, 72px);
}

.brand-card-row {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule-soft);
}

.brand-card-row:last-child {
    border-bottom: none;
}

.audio-card {
    display: block;
    width: 100%;
    max-width: 720px;
    height: 36px;
}

.tempo-frame {
    margin: 0 0 clamp(28px, 4vw, 40px);
}

.tempo-hist {
    display: block;
    width: 100%;
    max-width: 760px;
}

.mode-block {
    margin-top: clamp(28px, 3vw, 36px);
    padding-top: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--rule-soft);
}

.mode-panel {
    display: block;
    width: 100%;
    max-width: 760px;
}

@media (max-width: 640px) {
    .brand-card-row {
        grid-template-columns: 1fr;
    }
}

/* ============ Spot Scorer: interactive components ============ */

.url-block {
    margin: 0 0 clamp(28px, 4vw, 40px);
    padding: clamp(20px, 3vw, 32px);
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--paper);
}

.url-block-disabled {
    border-color: var(--rule);
    background: oklch(0.97 0.005 80);
}

.url-label {
    margin: 0 0 6px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
}

.url-help {
    margin: 0 0 16px;
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.55;
    max-width: 60ch;
}

.url-form {
    display: grid;
    grid-template-columns: 1fr 160px auto;
    gap: 10px;
    align-items: stretch;
}

.url-input,
.url-sector {
    font-family: var(--sans);
    font-size: 15px;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
}

.url-input:focus,
.url-sector:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
}

.url-submit {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 22px;
    border: none;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
}

.url-submit:hover { background: var(--accent); }
.url-submit:disabled { background: var(--ink-soft); cursor: wait; }

.url-status {
    margin: 14px 0 0;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 6px;
}

.url-status-loading { background: oklch(0.94 0.02 80); color: var(--ink); }
.url-status-error   { background: oklch(0.94 0.06 25); color: var(--accent); }
.url-status-ok      { background: oklch(0.94 0.04 145); color: oklch(0.30 0.10 145); }

@media (max-width: 640px) {
    .url-form { grid-template-columns: 1fr; }
}

/* ===== Compare-two-spots ===== */

.url-block-compare { border-color: var(--accent); }

.cmp-form {
    display: grid;
    grid-template-columns: 1fr 1fr 160px auto;
    gap: 10px;
}

.cmp-results {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-soft);
}

.cmp-section {
    margin: 18px 0 8px;
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.cmp-row {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    gap: 14px;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid var(--rule-soft);
}

.cmp-row-headers { font-weight: 600; padding-top: 0; }

.cmp-row-label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
}

.cmp-cell { display: flex; flex-direction: column; gap: 4px; }

.cmp-val {
    margin: 0;
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
}

.cmp-b .cmp-val { color: var(--accent); }

.cmp-hdr {
    margin: 0;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.cmp-cell .gauge {
    max-width: 100%;
    height: 22px;
}

@media (max-width: 720px) {
    .cmp-form { grid-template-columns: 1fr; }
    .cmp-row { grid-template-columns: 1fr; }
}

.picker-block {
    margin: 0 0 clamp(40px, 5vw, 64px);
    padding: clamp(20px, 3vw, 32px);
    background: oklch(0.97 0.005 80);
    border-radius: 12px;
}

.picker-label {
    display: block;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 10px;
}

.picker {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 500;
    padding: 10px 16px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    width: 100%;
    max-width: 480px;
    cursor: pointer;
}

.spot-header {
    margin-top: 16px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
}

.spot-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
}

.spot-brand {
    color: var(--ink);
    font-weight: 600;
}

.spot-sep {
    color: var(--ink-faint);
}

.score-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: clamp(40px, 5vw, 64px);
}

.metric-card {
    padding: 18px 20px;
    border: 1px solid var(--rule-soft);
    border-radius: 8px;
    background: var(--paper);
}

.metric-label {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 6px;
}

.metric-value {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    margin: 0 0 14px;
    letter-spacing: -0.015em;
}

.gauge {
    display: block;
    width: 100%;
    max-width: 280px;
    height: 28px;
    margin: 4px 0 6px;
}

.metric-note {
    margin: 0;
    font-size: 11px;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
}

.sector-row-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: clamp(40px, 5vw, 64px);
}

.sector-row {
    display: grid;
    grid-template-columns: 160px 80px 1fr 240px;
    gap: 16px;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-soft);
}

.sector-row:last-child { border-bottom: none; }

.sector-row-label {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
}

.sector-row-value {
    margin: 0;
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
}

.sector-row-context {
    margin: 0;
    font-size: 11px;
    color: var(--ink-soft);
    text-align: right;
}

.targets {
    list-style: none;
    padding: 0;
    margin: 0 0 clamp(40px, 5vw, 64px);
}

.target-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 24px;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--rule-soft);
}

.target-item:last-child { border-bottom: none; }

.target-metric {
    grid-column: 2;
    margin: 0 0 4px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
}

.target-move {
    grid-column: 2;
    margin: 0 0 6px;
    font-family: var(--serif);
    font-size: 18px;
    color: var(--ink);
}

.target-move .cur {
    color: var(--ink-soft);
    text-decoration: line-through;
    margin: 0 2px;
}

.target-move .tgt {
    color: var(--accent);
    font-weight: 700;
    margin: 0 2px;
}

.target-rationale {
    grid-column: 2;
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
    max-width: 56ch;
    line-height: 1.5;
}

.target-empty {
    font-size: 14px;
    color: var(--ink-soft);
    font-style: italic;
    padding: 16px;
}

@media (max-width: 720px) {
    .sector-row {
        grid-template-columns: 1fr;
        gap: 4px;
    }
    .sector-row-context {
        text-align: left;
    }
}
